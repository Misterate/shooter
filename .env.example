# ── Kalshi credentials ──────────────────────────────────────────────────────
# Option A: email + password (simpler, gets a JWT)
KALSHI_EMAIL=you@example.com
KALSHI_PASSWORD=your_password

# Option B: API key + RSA private key (recommended for production)
# Generate a key pair, upload the public key to the Kalshi dashboard, then:
KALSHI_KEY_ID=your-api-key-id
KALSHI_PRIVATE_KEY_PATH=kalshi_private_key.pem   # PEM file with RSA private key

# Base URL (default is production)
KALSHI_BASE_URL=https://trading-api.kalshi.com/trade-api/v2

# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Market scan criteria ──────────────────────────────────────────────────────
# YES price range in cents (win/loss ratio sweet-spot, defaults: 0.5–4 cents)
MIN_MARKET_PRICE_PCT=0.5
MAX_MARKET_PRICE_PCT=4.0

# Our probability must be at least this many times the market price to qualify
PROBABILITY_EDGE_THRESHOLD=1.5

# Look-ahead window in days (default: 7)
SCAN_HORIZON_DAYS=7

# How many top markets to track (default: 10)
TOP_N_MARKETS=10

# ── S-curve scheduling ───────────────────────────────────────────────────────
# Check interval bounds in seconds
MAX_CHECK_INTERVAL=3600   # 1 hour  (used when expiry is far away)
MIN_CHECK_INTERVAL=60     # 1 minute (used right before expiry)

# Sigmoid parameters: inflection point (hours from expiry) and steepness
SIGMOID_INFLECTION_HOURS=4.0
SIGMOID_STEEPNESS=1.0

# ── Trade execution ──────────────────────────────────────────────────────────
# PAPER_TRADING=true  →  log signals only, never submit real orders
PAPER_TRADING=true

MAX_TRADE_CONTRACTS=100   # max contracts per order

# Edge multiplier required to trigger a signal for breaking vs slow-brew news
BREAKING_NEWS_MULTIPLIER=3.0
SLOW_NEWS_MULTIPLIER=1.5

# ── Misc ─────────────────────────────────────────────────────────────────────
DB_PATH=shooter.db
LOG_LEVEL=INFO
